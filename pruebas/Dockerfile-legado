#---------------NOTA IMPORTANTE---------------
# Este Dockerfile construye una imagen de Docker para la aplicación Spring Petclinic.
# La imagen final solo incluye el JRE y el .jar, sin el entorno de desarrollo.

# ------- Etapa 1: build de la aplicación -------
FROM maven:3.9-eclipse-temurin-17 AS build
WORKDIR /app

# Copiamos primero solo el pom.xml y el wrapper para aprovechar el cache de dependencias
COPY pom.xml .
COPY .mvn .mvn
COPY mvnw .
RUN mvn -B dependency:go-offline

# Ahora copiamos el resto del código y compilamos
COPY src ./src
RUN mvn -B clean package -DskipTests

# ------- Etapa 2: imagen final, solo con el JRE y el .jar -------
FROM eclipse-temurin:17-jre-jammy
WORKDIR /app

COPY --from=build /app/target/*.jar app.jar

EXPOSE 8080

ENTRYPOINT ["java", "-jar", "app.jar"]
